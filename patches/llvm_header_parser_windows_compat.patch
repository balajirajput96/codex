# What: make hermetic LLVM's header parser compile on native Windows hosts.
# Why: the parser is a small process-launcher utility.  Its POSIX include and
# symbols (`unistd.h`, `close`, and `execv`) prevent it from compiling with the
# hosted MSVC C++ toolchain used by local public-fork CI.

diff --git a/tools/internal/header_parser.c b/tools/internal/header_parser.c
--- a/tools/internal/header_parser.c
+++ b/tools/internal/header_parser.c
@@ -3,4 +3,10 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#if defined(_WIN32)
+#include <io.h>
+#include <process.h>
+#define close _close
+#else
 #include <unistd.h>
+#endif
